#notes-directory {
    width: 1fr;
}

#notes-area {
    width: 2fr;
}

.input-hidden {
    display: none;
    visibility: hidden;
}

DeleteScreen, SaveScreen {
    align: center middle;
}

#delete-dialog {
    grid-size: 2;
    grid-gutter: 1 2;
    grid-rows: 1fr 3;
    padding: 0 1;
    width: 60;
    height: 11;
    border: thick $background 80%;
}

#question {
    column-span: 2;
    height: 1fr;
    width: 1fr;
    content-align: center middle;
}

#yes, #no {
    width: 100%;
}